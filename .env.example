# Copy to `.env` in this folder. Dashboard loads `.env` on start.
# Never commit `.env`, keystores, or passwords.

# --- ETH liquidator (Spark / Compound / Morpho + Aave 4-arg) ---
# After `forge create` of contracts/GenericFlashLiquidator.sol:
LIQ_GENERIC_CONTRACT=
# Existing Aave-only executor, OR the same address as LIQ_GENERIC_CONTRACT.
# If LIQ_CONTRACT is empty, dashboard uses LIQ_GENERIC_CONTRACT for Aave too.
LIQ_CONTRACT=

# Bot signer (same names live_liquidator.py / liquidation_bot.py read)
KEYSTORE_PATH=
KEYSTORE_PW=

# Optional: extra ETH when the bot wallet is light
SPONSOR_KEYSTORE=
SPONSOR_PW=

# Only if you deployed GenericFlashLiquidator from a wallet that is NOT the bot:
# BOT_EOA=0x...

# Optional RPC (deploy scripts; dashboard has its own pool)
# AAVE_RPC=https://ethereum-rpc.publicnode.com
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# --- ETH DEX arb (NOT required for Spark/Compound/Morpho liq) ---
# ARB_CONTRACT=
# ARB_FLASH_KIND=aave-v3

# Optional profit sweep of leftover bot ETH
# COLD_WALLET=

# Defaults stay sim until you Arm Keep Live in the dashboard
# SIM_ONLY=1
# SOL_SIM_ONLY=1

# --- Event-driven liquidation feeds (free-tier friendly) ---
# Comma-separated WSS endpoints. First event wins; providers auto-bench on failure.
# ETH: any WSS that supports eth_subscribe logs/newHeads (QuickNode, Alchemy free, publicnode)
ETH_FEED_ENABLED=1
# ETH_FEED_WSS_URLS=wss://ethereum-rpc.publicnode.com,wss://YOUR_NODE.quiknode.pro/HEX/
# SOL: standard Solana pubsub endpoints (mainnet-beta allows a few subs per IP)
SOL_FEED_ENABLED=1
# SOL_FEED_WS_URLS=wss://api.mainnet-beta.solana.com,wss://solana-rpc.publicnode.com
FEED_BENCH_THRESHOLD=3
FEED_BENCH_WINDOW_S=300
FEED_BENCH_SECONDS=600
